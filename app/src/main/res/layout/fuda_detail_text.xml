<?xml version="1.0" encoding="utf-8"?>
<!-- The text half of FudaDetailPage. Shared by the portrait and landscape layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/detail_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        tools:text="第1首" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detail_kimariji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            tools:text="あきの" />

        <TextView
            android:id="@+id/detail_kimariji_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="3字決まり" />
    </LinearLayout>

    <TextView
        style="@style/FudaDetail.Label"
        android:text="@string/detail_kaminoku" />

    <TextView
        android:id="@+id/detail_kaminoku"
        style="@style/FudaDetail.Verse"
        tools:text="秋の田の　かりほの庵の　苫をあらみ" />

    <TextView
        android:id="@+id/detail_kaminoku_hiragana"
        style="@style/FudaDetail.Kana"
        tools:text="あきのたの　かりほのいほの　とまをあらみ" />

    <TextView
        style="@style/FudaDetail.Label"
        android:text="@string/detail_shimonoku" />

    <TextView
        android:id="@+id/detail_shimonoku"
        style="@style/FudaDetail.Verse"
        tools:text="わが衣手は　露にぬれつつ" />

    <TextView
        android:id="@+id/detail_shimonoku_hiragana"
        style="@style/FudaDetail.Kana"
        tools:text="わがころもでは　つゆにぬれつつ" />

    <TextView
        style="@style/FudaDetail.Label"
        android:text="@string/detail_poet" />

    <TextView
        android:id="@+id/detail_poet"
        style="@style/FudaDetail.Verse"
        tools:text="天智天皇" />

    <TextView
        style="@style/FudaDetail.Label"
        android:text="@string/detail_note" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/detail_note_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/detail_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
